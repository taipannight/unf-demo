// =====================================================================
// Модуль формы внешней обработки "Обмен с PostgreSQL через HTTP API"
// Команды формы (создайте в редакторе формы и привяжите к процедурам):
//   ПроверитьСоединение          - проверка адреса и ключа
//   ЗагрузитьНоменклатуру        - PostgreSQL -> Справочник.Номенклатура
//   ЗагрузитьКонтрагентов        - PostgreSQL -> Справочник.Контрагенты
//   ОтправитьТестовогоКонтрагента - 1С -> PostgreSQL (один контрагент)
//   ОтправитьКонтрагентовИз1С    - 1С -> PostgreSQL (до 50 контрагентов)
//   ОтправитьТестовуюРеализацию  - 1С -> PostgreSQL (документ с двумя строками)
// Запускайте сначала на ТЕСТОВОЙ базе УНФ.
// =====================================================================

// ---------- Настройки: впишите свои значения ----------

&НаСервереБезКонтекста
Функция АдресСервера()
	Возврат "ВАШ_ДОМЕН.duckdns.org";
КонецФункции

&НаСервереБезКонтекста
Функция КлючДоступа()
	Возврат "ВАШ_API_КЛЮЧ";
КонецФункции

// ---------- Обработчики команд (клиент) ----------

&НаКлиенте
Процедура ПроверитьСоединение(Команда)
	Сообщить(ПроверитьСоединениеНаСервере());
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьНоменклатуру(Команда)
	Сообщить(ЗагрузитьНоменклатуруНаСервере());
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьКонтрагентов(Команда)
	Сообщить(ЗагрузитьКонтрагентовНаСервере());
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьТестовогоКонтрагента(Команда)
	Сообщить(ОтправитьТестовогоКонтрагентаНаСервере());
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьКонтрагентовИз1С(Команда)
	Сообщить(ОтправитьКонтрагентовНаСервере());
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьТестовуюРеализацию(Команда)
	Сообщить(ОтправитьТестовуюРеализациюНаСервере());
КонецПроцедуры

// ---------- Работа с API ----------

&НаСервереБезКонтекста
Функция ВызватьAPI(ТипЗапроса, Путь, ТелоСтруктура = Неопределено)

	Соединение = Новый HTTPСоединение(АдресСервера(), 443, , , , 60, Новый ЗащищенноеСоединениеOpenSSL());

	Запрос = Новый HTTPЗапрос(Путь);
	Запрос.Заголовки.Вставить("X-API-Key", КлючДоступа());

	Если ТелоСтруктура <> Неопределено Тогда
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, ТелоСтруктура);
		ТекстЗапроса = ЗаписьJSON.Закрыть();
		Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Запрос.УстановитьТелоИзСтроки(ТекстЗапроса, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;

	Если ТипЗапроса = "POST" Тогда
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Иначе
		Ответ = Соединение.Получить(Запрос);
	КонецЕсли;

	ТекстОтвета = Ответ.ПолучитьТелоКакСтроку("UTF-8");
	Если Ответ.КодСостояния >= 300 Тогда
		ВызватьИсключение "Ошибка API, код " + Ответ.КодСостояния + ": " + ТекстОтвета;
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТекстОтвета);
	Результат = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьСоединениеНаСервере()
	Попытка
		Данные = ВызватьAPI("GET", "/nomenclature?limit=1");
		Возврат "Соединение работает, ключ принят. Первая позиция: " + Данные[0].name;
	Исключение
		Возврат "Ошибка: " + ОписаниеОшибки();
	КонецПопытки;
КонецФункции

// ---------- Вспомогательные функции ----------

&НаСервереБезКонтекста
Функция СтрокаИлиПусто(Значение)
	Если Значение = Неопределено ИЛИ ТипЗнч(Значение) = Тип("Null") Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Значение);
КонецФункции

// Устанавливает реквизит, только если он есть в вашей версии УНФ и значение заполнено
&НаСервереБезКонтекста
Процедура УстановитьЗначениеРеквизита(Объект, ИмяРеквизита, Значение)
	Если Значение = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;
	Если Объект.Метаданные().Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Объект[ИмяРеквизита] = Значение;
КонецПроцедуры

&НаСервереБезКонтекста
Функция НайтиИлиСоздатьГруппуНоменклатуры(Наименование)
	Если НЕ ЗначениеЗаполнено(Наименование) Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	Группа = Справочники.Номенклатура.НайтиПоНаименованию(Наименование, Истина);
	Если Группа.Пустая() ИЛИ НЕ Группа.ЭтоГруппа Тогда
		НоваяГруппа = Справочники.Номенклатура.СоздатьГруппу();
		НоваяГруппа.Наименование = Наименование;
		НоваяГруппа.Записать();
		Возврат НоваяГруппа.Ссылка;
	КонецЕсли;
	Возврат Группа;
КонецФункции

&НаСервереБезКонтекста
Функция НайтиЕдиницуИзмерения()
	Попытка
		Возврат Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796"); // шт
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

&НаСервереБезКонтекста
Функция ТипНоменклатуры(ЭтоУслуга)
	Попытка
		Если ЭтоУслуга Тогда
			Возврат Вычислить("Перечисления.ТипыНоменклатуры.Услуга");
		КонецЕсли;
		Возврат Вычислить("Перечисления.ТипыНоменклатуры.Запас");
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

&НаСервереБезКонтекста
Функция ВидКонтрагента(Наименование)
	Попытка
		Если СтрНачинаетсяС(Наименование, "ИП ") Тогда
			Возврат Вычислить("Перечисления.ЮридическоеФизическоеЛицо.ИндивидуальныйПредприниматель");
		КонецЕсли;
		Возврат Вычислить("Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо");
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// ---------- PostgreSQL -> 1С ----------

&НаСервереБезКонтекста
Функция ЗагрузитьНоменклатуруНаСервере()

	Попытка
		Данные = ВызватьAPI("GET", "/nomenclature?limit=5000");
	Исключение
		Возврат "Ошибка: " + ОписаниеОшибки();
	КонецПопытки;

	Создано = 0;
	Пропущено = 0;
	Ошибок = 0;

	Для Каждого Позиция Из Данные Цикл

		Если НЕ Справочники.Номенклатура.НайтиПоКоду(Позиция.code).Пустая() Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;

		Попытка
			Элемент = Справочники.Номенклатура.СоздатьЭлемент();
			Элемент.Код = Позиция.code;
			Элемент.Наименование = Позиция.name;
			Элемент.Родитель = НайтиИлиСоздатьГруппуНоменклатуры(Позиция.group_name);
			УстановитьЗначениеРеквизита(Элемент, "НаименованиеПолное", Позиция.name);
			УстановитьЗначениеРеквизита(Элемент, "ЕдиницаИзмерения", НайтиЕдиницуИзмерения());
			УстановитьЗначениеРеквизита(Элемент, "ТипНоменклатуры", ТипНоменклатуры(Позиция.is_service));
			Элемент.Записать();
			Создано = Создано + 1;
		Исключение
			Ошибок = Ошибок + 1;
			Сообщить("Не записана позиция " + Позиция.code + ": " + ОписаниеОшибки());
		КонецПопытки;

	КонецЦикла;

	Возврат "Номенклатура: создано " + Создано + ", уже была " + Пропущено + ", ошибок " + Ошибок;

КонецФункции

&НаСервереБезКонтекста
Функция ЗагрузитьКонтрагентовНаСервере()

	Попытка
		Данные = ВызватьAPI("GET", "/counterparties?limit=5000");
	Исключение
		Возврат "Ошибка: " + ОписаниеОшибки();
	КонецПопытки;

	Создано = 0;
	Пропущено = 0;
	Ошибок = 0;

	Для Каждого Позиция Из Данные Цикл

		ИНН = СтрокаИлиПусто(Позиция.inn);
		Если ИНН <> "" И НЕ Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", ИНН).Пустая() Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;

		Попытка
			Объект = Справочники.Контрагенты.СоздатьЭлемент();
			Объект.Наименование = Позиция.name;
			УстановитьЗначениеРеквизита(Объект, "НаименованиеПолное", Позиция.name);
			УстановитьЗначениеРеквизита(Объект, "ИНН", ИНН);
			УстановитьЗначениеРеквизита(Объект, "КПП", СтрокаИлиПусто(Позиция.kpp));
			УстановитьЗначениеРеквизита(Объект, "ЮридическоеФизическоеЛицо", ВидКонтрагента(Позиция.name));
			Если Позиция.kind = "Покупатель" Тогда
				УстановитьЗначениеРеквизита(Объект, "Покупатель", Истина);
			Иначе
				УстановитьЗначениеРеквизита(Объект, "Поставщик", Истина);
			КонецЕсли;
			Объект.Записать();
			Создано = Создано + 1;
		Исключение
			Ошибок = Ошибок + 1;
			Сообщить("Не записан контрагент " + Позиция.name + ": " + ОписаниеОшибки());
		КонецПопытки;

	КонецЦикла;

	Возврат "Контрагенты: создано " + Создано + ", уже были " + Пропущено + ", ошибок " + Ошибок;

КонецФункции

// ---------- 1С -> PostgreSQL ----------

&НаСервереБезКонтекста
Функция ОтправитьТестовогоКонтрагентаНаСервере()
	Попытка
		Тело = Новый Структура;
		Тело.Вставить("name", "ООО «Тест из 1С»");
		Тело.Вставить("inn", "7700000001");
		Тело.Вставить("kind", "Покупатель");
		Тело.Вставить("city", "Москва");
		Результат = ВызватьAPI("POST", "/counterparties", Тело);
		Возврат "Контрагент в PostgreSQL, id = " + Результат.id + ?(Результат.existing, " (уже был)", " (создан)");
	Исключение
		Возврат "Ошибка: " + ОписаниеОшибки();
	КонецПопытки;
КонецФункции

&НаСервереБезКонтекста
Функция ОтправитьКонтрагентовНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 50
	|	Контрагенты.Наименование КАК Наименование,
	|	Контрагенты.ИНН КАК ИНН,
	|	Контрагенты.КПП КАК КПП
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	НЕ Контрагенты.ЭтоГруппа";
	Выборка = Запрос.Выполнить().Выбрать();

	Отправлено = 0;
	Ошибок = 0;

	Пока Выборка.Следующий() Цикл
		Если ПустаяСтрока(Выборка.ИНН) Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Тело = Новый Структура;
			Тело.Вставить("name", Выборка.Наименование);
			Тело.Вставить("inn", Выборка.ИНН);
			Тело.Вставить("kpp", Выборка.КПП);
			Тело.Вставить("kind", "Покупатель");
			ВызватьAPI("POST", "/counterparties", Тело);
			Отправлено = Отправлено + 1;
		Исключение
			Ошибок = Ошибок + 1;
			Сообщить("Не отправлен " + Выборка.Наименование + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	Возврат "Отправлено контрагентов: " + Отправлено + ", ошибок " + Ошибок;

КонецФункции

&НаСервереБезКонтекста
Функция ОтправитьТестовуюРеализациюНаСервере()
	Попытка
		Строки = Новый Массив;
		Строки.Добавить(Новый Структура("item_id,qty,price", 1, 2, 65000));
		Строки.Добавить(Новый Структура("item_id,qty,price", 20, 5, 1500));

		Тело = Новый Структура;
		Тело.Вставить("doc_number", "ТЕСТ-" + Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss"));
		Тело.Вставить("doc_date", Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd"));
		Тело.Вставить("customer_id", 7);
		Тело.Вставить("manager_id", 3);
		Тело.Вставить("lines", Строки);

		Результат = ВызватьAPI("POST", "/sales", Тело);
		Возврат "Реализация создана в PostgreSQL, id = " + Результат.id + ", сумма " + Результат.total;
	Исключение
		Возврат "Ошибка: " + ОписаниеОшибки();
	КонецПопытки;
КонецФункции
